# ===========================================================================
# FamilySaathi — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ===========================================================================

# --- Database (Supabase Postgres) -------------------------------------------
# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL = the POOLED connection (port 6543, "Transaction" mode) used at
#                runtime on serverless. Append ?pgbouncer=true&connection_limit=1
# DIRECT_URL   = the DIRECT connection (port 5432) used by prisma migrate/db push.
#
# The app works WITHOUT these set — it falls back to built-in seed data.
# Set them to make drivers/FAQs/enquiries fully database-driven.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Public business details (safe to expose to the browser) ----------------
# Change these to go live. Defaults are placeholders.
# WhatsApp number: country code + number, no "+" or spaces. e.g. 919876543210
NEXT_PUBLIC_WA_NUMBER="910000000000"
NEXT_PUBLIC_PHONE="+910000000000"
NEXT_PUBLIC_EMAIL="hello@familysaathi.in"
NEXT_PUBLIC_SITE_URL="https://www.familysaathi.in"
